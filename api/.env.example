# VleisKraft™ API — Environment Variables
# Copy to .env and fill in real values

# Server
NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
APP_ORIGIN=https://vleiskraft.vcds.co.za
API_URL=https://vleiskraft-api.onrender.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/vleiskraft

# PayFast LIVE
PAYFAST_MERCHANT_ID=11910323
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase

# Abacus AI (VleisAI™ + Whisper + Vision)
ABACUS_API_KEY=your-abacus-api-key

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=5aad73a7b1178f7db26f220ec21ac13e
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=lingering-glade-2094
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# BulkSMS.co.za
BULKSMS_TOKEN=your-token-id:your-token-secret

# OpenWeatherMap (Braai Weather Alerts)
OPENWEATHER_API_KEY=your-owm-api-key

# Sentry
SENTRY_DSN=https://your-dsn@de.sentry.io/project

# Stream.io (Stockvel Chat)
STREAM_API_KEY=xdpp6ngtjmpz
STREAM_API_SECRET=your-stream-secret

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-token

ANTHROPIC_API_KEY=your_anthropic_api_key
