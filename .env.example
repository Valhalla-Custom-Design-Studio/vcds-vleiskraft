# VleisKraft™ Environment Variables
# Copy to .env and fill in values — NEVER commit .env

# API
EXPO_PUBLIC_API_URL=https://vleiskraft-api.onrender.com
EXPO_PUBLIC_ENV=production

# Sentry (error tracking)
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_DSN@de.sentry.io/PROJECT_ID

# PostHog (analytics)
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_POSTHOG_KEY

# Stream.io (real-time chat)
EXPO_PUBLIC_STREAM_KEY=YOUR_STREAM_PUBLIC_KEY
STREAM_API_SECRET=YOUR_STREAM_SECRET

# Google Maps (delivery address autocomplete)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_KEY

# Cloudflare R2 (image storage) — SERVER SIDE ONLY
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET=YOUR_R2_BUCKET_NAME
R2_PUBLIC_URL=https://pub-YOUR_BUCKET.r2.dev

# BulkSMS (order SMS confirmations)
BULKSMS_TOKEN=YOUR_BULKSMS_USERNAME:YOUR_BULKSMS_PASSWORD

# PayFast (Platinum subscriptions)
PAYFAST_MERCHANT_ID=YOUR_PAYFAST_MERCHANT_ID
PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY
PAYFAST_PASSPHRASE=YOUR_PASSPHRASE

# OpenWeatherMap (braai weather alerts)
OPENWEATHER_API_KEY=YOUR_OWM_KEY

# Database
DATABASE_URL=postgresql://user:pass@host:5432/vleiskraft

# JWT
JWT_SECRET=YOUR_JWT_SECRET
