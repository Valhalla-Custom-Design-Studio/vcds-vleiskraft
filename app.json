{
  "expo": {
    "name": "VleisKraft\u2122",
    "slug": "vcds-vleiskraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0000"
    },
    "scheme": "vleiskraft",
    "android": {
      "package": "co.za.vcds.vleiskraft",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0000"
      }
    },
    "ios": {
      "bundleIdentifier": "co.za.vcds.vleiskraft"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(BUNDLE_IDENTIFIER) to access your photos.",
          "cameraPermission": "Allow $(BUNDLE_IDENTIFIER) to access your camera."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "valhalla-custom-design-studios",
          "project": "vcds-vleiskraft"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "545a0f06-c481-4791-af5d-3591c73a9c8a"
      }
    },
    "owner": "valhalla-custom-design-studios-org"
  }
}