{
  "expo": {
    "name": "VleisKraft\u2122",
    "slug": "vcds-vleiskraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0000"
    },
    "scheme": "vleiskraft",
    "android": {
      "package": "co.za.vcds.vleiskraft",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0000"
      }
    },
    "ios": {
      "bundleIdentifier": "co.za.vcds.vleiskraft"
    },
    "plugins": [
      [
        "./plugins/withKotlinVersionFix",
        {
          "kotlinVersion": "2.0.21"
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError",
              "org.gradle.daemon": "true",
              "org.gradle.parallel": "true",
              "org.gradle.configureondemand": "true",
              "android.useAndroidX": "true",
              "android.enableJetifier": "false",
              "EXPO_USE_COMMUNITY_AUTOLINKING": "1",
              "kotlinVersion": "2.0.21"
            },
            "extraBuildGradleContent": "ext {\n    kotlinVersion = \"2.0.21\"\n}\n"
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(BUNDLE_IDENTIFIER) to access your photos.",
          "cameraPermission": "Allow $(BUNDLE_IDENTIFIER) to access your camera."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "valhalla-custom-design-studios",
          "project": "vcds-vleiskraft",
          "uploadSourceMaps": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "545a0f06-c481-4791-af5d-3591c73a9c8a"
      }
    },
    "owner": "valhalla-custom-design-studios-org",
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
