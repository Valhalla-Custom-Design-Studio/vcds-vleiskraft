# VleisKraft™ Environment Variables
# Copy to .env and fill in real values

# API
EXPO_PUBLIC_API_URL=https://vleiskraft-api.onrender.com/api/v1

# Database (backend only)
DATABASE_URL=postgresql://user:pass@host:5432/vleiskraft

# Auth
JWT_SECRET=YOUR_JWT_SECRET

# PayFast
PAYFAST_MERCHANT_ID=YOUR_PAYFAST_MERCHANT_ID
PAYFAST_MERCHANT_KEY=YOUR_PAYFAST_MERCHANT_KEY
PAYFAST_PASSPHRASE=YOUR_PAYFAST_PASSPHRASE
PAYFAST_SANDBOX=false

# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_DSN@sentry.io/PROJECT_ID
SENTRY_DSN=https://YOUR_DSN@sentry.io/PROJECT_ID

# PostHog
EXPO_PUBLIC_POSTHOG_API_KEY=phc_YOUR_POSTHOG_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# Cloudflare R2
CLOUDFLARE_R2_BUCKET=YOUR_R2_BUCKET_NAME
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
CLOUDFLARE_R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET

# BulkSMS
BULKSMS_TOKEN_ID=YOUR_BULKSMS_TOKEN_ID
BULKSMS_TOKEN_SECRET=YOUR_BULKSMS_TOKEN_SECRET

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Firebase (FCM)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Anthropic
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
